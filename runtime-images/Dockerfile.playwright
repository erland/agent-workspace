# Optional browser-test runtime. Browser binaries are downloaded for the project's
# installed Playwright version after npm/pnpm installation, not baked into the image.
ARG BASE_IMAGE=ghcr.io/erland/agent-workspace-runtime:java21-node22-v9
FROM ${BASE_IMAGE}

USER root
ARG PLAYWRIGHT_DEPS_VERSION=1.56.1
ENV PLAYWRIGHT_BROWSERS_PATH=/home/agent-workspace/.cache/ms-playwright

# Install OS libraries at image-build time to avoid apt operations in Modal.
# The temporary CLI is removed after installing the Chromium system dependencies.
RUN set -eux; \
    npm install --global "playwright@${PLAYWRIGHT_DEPS_VERSION}"; \
    node "$(npm root -g)/playwright/cli.js" install-deps chromium; \
    apt-get update; \
    apt-get install -y --no-install-recommends poppler-utils; \
    command -v pdftoppm; \
    pdftoppm -v; \
    npm uninstall --global playwright; \
    mkdir -p "${PLAYWRIGHT_BROWSERS_PATH}"; \
    chown -R agent-workspace:agent-workspace /home/agent-workspace/.cache; \
    rm -rf /var/lib/apt/lists/* /root/.npm/_cacache

USER agent-workspace
WORKDIR /workspace
CMD ["sleep", "3600"]
