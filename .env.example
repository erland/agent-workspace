MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=agent-workspace-dev

# DEV-011 production-style Modal OAuth spike.
# Obtain the client id/secret from Modal for a third-party OAuth integration.
# The two refresh tokens must belong to two different Modal test users/workspaces.
AGENT_WORKSPACE_MODAL_OAUTH_CLIENT_ID=
AGENT_WORKSPACE_MODAL_OAUTH_CLIENT_SECRET=
AGENT_WORKSPACE_TEST_USER1_MODAL_OAUTH_REFRESH_TOKEN=
AGENT_WORKSPACE_TEST_USER2_MODAL_OAUTH_REFRESH_TOKEN=

# DEV-013 remote MCP resource server
AGENT_WORKSPACE_PUBLIC_BASE_URL=https://workspace.example/
# Agent Workspace is the OAuth authorization server by default.
AGENT_WORKSPACE_OAUTH_AUDIENCE=https://workspace.example/mcp
AGENT_WORKSPACE_OAUTH_SCOPE=agent-workspace
# Optional comma-separated pilot allowlist. When set, authenticated users without a matching email receive 403.
AGENT_WORKSPACE_ALLOWED_EMAILS=user1@example.com,user2@example.com

# Google is the upstream identity provider for both /settings and MCP OAuth.
# Register https://workspace.example/auth/google/callback as an authorized redirect URI.
AGENT_WORKSPACE_GOOGLE_CLIENT_ID=
AGENT_WORKSPACE_GOOGLE_CLIENT_SECRET=

# Ed25519 private key, Base64-encoded PKCS#8 DER.
# Generate: openssl genpkey -algorithm ED25519 -outform DER | openssl base64 -A
AGENT_WORKSPACE_AUTH_SIGNING_KEY=

# Signs the short-lived login state and settings session.
AGENT_WORKSPACE_WEB_SESSION_SECRET=

# Optional comma-separated trusted origins for Client ID Metadata Documents (CIMD).
# Dynamic Client Registration remains available for compatible MCP clients.
AGENT_WORKSPACE_OAUTH_CLIENT_METADATA_ORIGINS=

# Encrypts personal Modal credentials at rest.
# Generate exactly 32 random bytes, Base64 encoded: openssl rand -base64 32
AGENT_WORKSPACE_CREDENTIAL_ENCRYPTION_KEY=

# Prebuilt sandbox runtime images. Defaults shown here match the images published by this repository.
AGENT_WORKSPACE_RUNTIME_IMAGE_PREFIX=ghcr.io/erland/agent-workspace-runtime
AGENT_WORKSPACE_RUNTIME_IMAGE_VERSION=2

HOST=0.0.0.0
PORT=3000

# Example server-side execution credential reference `env:modal_user_1`
# AGENT_WORKSPACE_CREDENTIAL_MODAL_USER_1_REFRESH_TOKEN=
# AGENT_WORKSPACE_CREDENTIAL_MODAL_USER_1_CLIENT_ID=
# AGENT_WORKSPACE_CREDENTIAL_MODAL_USER_1_CLIENT_SECRET=

# DEV-015 persistence/deployment
DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/agent_workspace
AGENT_WORKSPACE_VERSION=0.1.0-dev.15

# Temporary source/artifact/screenshot storage.
# Mount this path as a persistent Coolify volume.
AGENT_WORKSPACE_STORAGE_DIR=/data

# Signs short-lived public artifact download links.
# Generate at least 32 random bytes, for example: openssl rand -base64 48
AGENT_WORKSPACE_ARTIFACT_SIGNING_KEY=
